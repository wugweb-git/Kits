{
  "core": {
    "font-family-base": {
      "$value": "'Inter Tight', system-ui, sans-serif",
      "$type": "fontFamily"
    },
    "font-family-mono": {
      "$value": "'Fragment Mono', ui-monospace, monospace",
      "$type": "fontFamily"
    },
    "line-height-none": {
      "$value": "1",
      "$type": "number"
    },
    "line-height-tight": {
      "$value": "1.2",
      "$type": "number"
    },
    "line-height-snug": {
      "$value": "1.375",
      "$type": "number"
    },
    "line-height-normal": {
      "$value": "1.5",
      "$type": "number"
    },
    "line-height-relaxed": {
      "$value": "1.625",
      "$type": "number"
    },
    "line-height-loose": {
      "$value": "2",
      "$type": "number"
    }
  },
  "font": {
    "display": {
      "$value": "{core.font-family-base}"
    },
    "body": {
      "$value": "{core.font-family-base}"
    },
    "mono": {
      "$value": "{core.font-family-mono}"
    },
    "weight-regular": {
      "$value": "400",
      "$type": "fontWeight"
    },
    "weight-medium": {
      "$value": "500",
      "$type": "fontWeight"
    },
    "weight-semibold": {
      "$value": "600",
      "$type": "fontWeight"
    },
    "weight-bold": {
      "$value": "700",
      "$type": "fontWeight"
    },
    "weight-extrabold": {
      "$value": "800",
      "$type": "fontWeight"
    }
  },
  "ts": {
    "display-size": {
      "$value": "4rem",
      "$type": "dimension"
    },
    "h1-size": {
      "$value": "3rem",
      "$type": "dimension"
    },
    "h2-size": {
      "$value": "2.25rem",
      "$type": "dimension"
    },
    "h3-size": {
      "$value": "1.5rem",
      "$type": "dimension"
    },
    "h4-size": {
      "$value": "1.25rem",
      "$type": "dimension"
    },
    "body-lg-size": {
      "$value": "1.25rem",
      "$type": "dimension"
    },
    "body-md-size": {
      "$value": "1rem",
      "$type": "dimension"
    },
    "body-sm-size": {
      "$value": "0.875rem",
      "$type": "dimension"
    },
    "label-md-size": {
      "$value": "0.875rem",
      "$type": "dimension"
    },
    "label-sm-size": {
      "$value": "0.75rem",
      "$type": "dimension"
    },
    "caption-size": {
      "$value": "0.75rem",
      "$type": "dimension"
    },
    "code-size": {
      "$value": "0.875rem",
      "$type": "dimension"
    }
  },
  "fluid": {
    "display": {
      "$value": "clamp(2.5rem, 5.5vw + 0.5rem, 5rem)"
    },
    "h1": {
      "$value": "clamp(2rem, 4vw + 0.5rem, 3rem)"
    },
    "h2": {
      "$value": "clamp(1.5rem, 2.5vw + 0.5rem, 2.25rem)"
    },
    "h3": {
      "$value": "clamp(1.25rem, 1.5vw + 0.5rem, 1.75rem)"
    },
    "h4": {
      "$value": "clamp(1.06rem, 1vw + 0.5rem, 1.375rem)"
    },
    "h5": {
      "$value": "clamp(1rem, 0.6vw + 0.7rem, 1.1875rem)"
    },
    "body-lg": {
      "$value": "clamp(1rem, 0.25vw + 0.9rem, 1.125rem)"
    },
    "body-md": {
      "$value": "clamp(0.9375rem, 0.25vw + 0.875rem, 1rem)"
    },
    "body-sm": {
      "$value": "clamp(0.8125rem, 0.1vw + 0.8rem, 0.875rem)"
    },
    "label": {
      "$value": "clamp(0.75rem, 0.1vw + 0.73rem, 0.875rem)"
    },
    "caption": {
      "$value": "clamp(0.625rem, 0.05vw + 0.62rem, 0.75rem)"
    }
  },
  "type": {
    "graphic-l": {
      "$value": "clamp(4rem, 14cqi, 12rem)"
    },
    "graphic-m": {
      "$value": "clamp(2.5rem, 9cqi, 7rem)"
    },
    "graphic-s": {
      "$value": "clamp(1.75rem, 6cqi, 4rem)"
    }
  },
  "t": {
    "display": {
      "$value": "{fluid.display}"
    },
    "h1": {
      "$value": "{fluid.h1}"
    },
    "h2": {
      "$value": "{fluid.h2}"
    },
    "h3": {
      "$value": "{fluid.h3}"
    },
    "h4": {
      "$value": "{fluid.h4}"
    },
    "h5": {
      "$value": "{fluid.h5}"
    },
    "h6": {
      "$value": "{ts.body-sm-size}"
    },
    "xl": {
      "$value": "{fluid.body-lg}"
    },
    "l": {
      "$value": "{fluid.body-lg}"
    },
    "lead": {
      "$value": "{fluid.body-lg}"
    },
    "body": {
      "$value": "{fluid.body-md}"
    },
    "sm": {
      "$value": "{fluid.body-sm}"
    },
    "micro": {
      "$value": "{fluid.caption}"
    }
  },
  "tracking": {
    "label": {
      "$value": "0.08em",
      "$type": "dimension"
    }
  },
  "lh": {
    "display": {
      "$value": "{core.line-height-tight}"
    },
    "h1": {
      "$value": "{core.line-height-tight}"
    },
    "h2": {
      "$value": "{core.line-height-snug}"
    },
    "h3": {
      "$value": "{core.line-height-snug}"
    },
    "h4": {
      "$value": "{core.line-height-normal}"
    },
    "h5": {
      "$value": "{core.line-height-snug}"
    },
    "h6": {
      "$value": "{core.line-height-normal}"
    },
    "xl": {
      "$value": "{core.line-height-relaxed}"
    },
    "l": {
      "$value": "{core.line-height-relaxed}"
    },
    "m": {
      "$value": "{core.line-height-normal}"
    },
    "s": {
      "$value": "{core.line-height-normal}"
    },
    "caption": {
      "$value": "{core.line-height-normal}"
    },
    "tight": {
      "$value": "{core.line-height-tight}"
    },
    "snug": {
      "$value": "{core.line-height-snug}"
    },
    "body": {
      "$value": "{core.line-height-normal}"
    }
  },
  "measure": {
    "min": {
      "$value": "35ch"
    },
    "max": {
      "$value": "60ch"
    }
  }
}
