{
  "duration": {
    "instant": {
      "$value": "100ms",
      "$type": "duration"
    },
    "fast": {
      "$value": "200ms",
      "$type": "duration"
    },
    "normal": {
      "$value": "300ms",
      "$type": "duration"
    },
    "slow": {
      "$value": "400ms",
      "$type": "duration"
    },
    "xslow": {
      "$value": "500ms",
      "$type": "duration"
    },
    "ms-150": {
      "$value": "150ms",
      "$type": "duration"
    },
    "ms-500": {
      "$value": "500ms",
      "$type": "duration"
    },
    "ms-700": {
      "$value": "700ms",
      "$type": "duration"
    },
    "ms-1000": {
      "$value": "1000ms",
      "$type": "duration"
    },
    "spring": {
      "$value": "400ms",
      "$type": "duration"
    }
  },
  "easing": {
    "in": {
      "$value": "cubic-bezier(0.4, 0, 1, 1)",
      "$type": "cubicBezier"
    },
    "out": {
      "$value": "cubic-bezier(0, 0, 0.2, 1)",
      "$type": "cubicBezier"
    },
    "in-out": {
      "$value": "cubic-bezier(0.4, 0, 0.2, 1)",
      "$type": "cubicBezier"
    },
    "linear": {
      "$value": "linear"
    },
    "standard": {
      "$value": "{easing.in-out}"
    },
    "accelerate": {
      "$value": "{easing.in}"
    },
    "decelerate": {
      "$value": "{easing.out}"
    },
    "spring": {
      "$value": "cubic-bezier(0.34, 1.56, 0.64, 1)",
      "$type": "cubicBezier"
    },
    "bounce": {
      "$value": "cubic-bezier(0.34, 1.56, 0.64, 1)",
      "$type": "cubicBezier"
    },
    "smooth": {
      "$value": "cubic-bezier(0.22, 1, 0.36, 1)",
      "$type": "cubicBezier"
    },
    "editorial": {
      "$value": "cubic-bezier(0.16, 1, 0.3, 1)",
      "$type": "cubicBezier"
    }
  },
  "ease": {
    "spring": {
      "$value": "linear(0, 0.0544, 0.1785, 0.3294, 0.4802, 0.6160, 0.7300, 0.8204, 0.8888, 0.9381, 0.9717, 0.9933, 1.0061, 1.0126, 1.0150, 1.0148, 1.0133, 1.0111, 1.0088, 1.0066, 1.0047, 1.0032, 1.0021, 1.0012, 1)"
    }
  },
  "transition": {
    "page": {
      "$value": "opacity {duration.normal} {easing.smooth}, transform {duration.normal} {easing.smooth}"
    },
    "overlay": {
      "$value": "opacity {duration.slow} {easing.smooth}"
    },
    "fast": {
      "$value": "background-color {duration.fast} {easing.out}, border-color {duration.fast} {easing.out}, color {duration.fast} {easing.out}, box-shadow {duration.fast} {easing.out}, transform {duration.fast} {easing.out}"
    }
  }
}
