{
  "breakpoint": {
    "xs": {
      "$value": "480px",
      "$type": "dimension"
    },
    "sm": {
      "$value": "640px",
      "$type": "dimension"
    },
    "md": {
      "$value": "768px",
      "$type": "dimension"
    },
    "lg": {
      "$value": "1024px",
      "$type": "dimension"
    },
    "xl": {
      "$value": "1200px",
      "$type": "dimension"
    },
    "2xl": {
      "$value": "1440px",
      "$type": "dimension"
    }
  },
  "layer": {
    "background": {
      "$value": "0",
      "$type": "dimension"
    },
    "base": {
      "$value": "1",
      "$type": "number"
    },
    "card": {
      "$value": "10",
      "$type": "number"
    },
    "popover": {
      "$value": "50",
      "$type": "number"
    },
    "dropdown": {
      "$value": "60",
      "$type": "number"
    },
    "modal": {
      "$value": "100",
      "$type": "number"
    },
    "toast": {
      "$value": "120",
      "$type": "number"
    },
    "tooltip": {
      "$value": "130",
      "$type": "number"
    },
    "overlay": {
      "$value": "140",
      "$type": "number"
    },
    "nav": {
      "$value": "10",
      "$type": "number"
    },
    "cursor": {
      "$value": "9999",
      "$type": "number"
    },
    "skip-link": {
      "$value": "9999",
      "$type": "number"
    }
  },
  "hero": {
    "overlay": {
      "$value": "rgba(10, 10, 12, 0.75)",
      "$type": "color"
    },
    "overlay-mid": {
      "$value": "rgba(10, 10, 12, 0.5)",
      "$type": "color"
    }
  },
  "shell": {
    "gutter": {
      "$value": "16px",
      "$type": "dimension"
    }
  },
  "grid": {
    "gap": {
      "$value": "16px",
      "$type": "dimension"
    }
  },
  "nav": {
    "height": {
      "$value": "calc({control.size} + 2 * {nav.bar-pad})"
    },
    "link-size": {
      "$value": "1rem",
      "$type": "dimension"
    },
    "link-line": {
      "$value": "1.5",
      "$type": "number"
    },
    "link-pad-block": {
      "$value": "10px",
      "$type": "dimension"
    },
    "link-pad-inline": {
      "$value": "{gap.3}"
    },
    "item-gap": {
      "$value": "{gap.3}"
    },
    "bar-pad": {
      "$value": "{gap.3}"
    },
    "logo-height": {
      "$value": "2.5rem",
      "$type": "dimension"
    }
  },
  "header": {
    "pad-block": {
      "$value": "16px",
      "$type": "dimension"
    },
    "height": {
      "$value": "calc({nav.height} + 2 * {header.pad-block})"
    }
  },
  "article": {
    "cols": {
      "$value": "minmax(0, 1fr)"
    },
    "areas": {
      "$value": "\"hero\" \"cover\" \"body\""
    },
    "column": {
      "$value": "720px",
      "$type": "dimension"
    },
    "cover-ratio": {
      "$value": "4 / 3"
    },
    "cover-height": {
      "$value": "auto"
    },
    "cover-position": {
      "$value": "static"
    },
    "title-size": {
      "$value": "{t.display}"
    }
  },
  "control": {
    "size": {
      "$value": "44px",
      "$type": "dimension"
    }
  },
  "pillar": {
    "thumb": {
      "$value": "88px",
      "$type": "dimension"
    },
    "thumb-sm": {
      "$value": "62px",
      "$type": "dimension"
    }
  },
  "thumb": {
    "min": {
      "$value": "180px",
      "$type": "dimension"
    }
  },
  "logo": {
    "grid-h": {
      "$value": "32px",
      "$type": "dimension"
    }
  },
  "author": {
    "photo": {
      "$value": "56px",
      "$type": "dimension"
    }
  },
  "share": {
    "btn": {
      "$value": "40px",
      "$type": "dimension"
    }
  },
  "bento": {
    "min": {
      "$value": "180px",
      "$type": "dimension"
    }
  },
  "culture": {
    "visual": {
      "$value": "380px",
      "$type": "dimension"
    }
  },
  "rail": {
    "width": {
      "$value": "min(85vw, 1200px)"
    },
    "peek": {
      "$value": "20%"
    }
  },
  "signature": {
    "width": {
      "$value": "2400px",
      "$type": "dimension"
    }
  }
}
