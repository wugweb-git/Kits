{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "kits/countdown",
	"title": "Countdown",
	"category": "widgets",
	"description": "The days left to a date.",
	"keywords": [ "countdown", "days left", "deadline", "kits" ],
	"textdomain": "kits-core",
	"attributes": {
		"date": { "type": "string", "default": "" },
		"label": { "type": "string", "default": "" }
	},
	"supports": { "html": false, "align": [ "wide" ], "color": { "background": true, "text": true }, "spacing": { "padding": true, "margin": true }, "typography": { "fontSize": true } },
	"editorScript": "file:../../build/blocks/index.js",
	"style": "file:./style.css"
}
