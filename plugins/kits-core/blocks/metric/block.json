{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "kits/metric",
	"title": "Metric",
	"category": "widgets",
	"description": "A number the site holds, with a label. Shows nothing until the number reaches its threshold.",
	"keywords": [ "number", "count", "metric", "impact", "kits" ],
	"textdomain": "kits-core",
	"attributes": {
		"key": { "type": "string", "default": "" },
		"label": { "type": "string", "default": "" },
		"min": { "type": "number", "default": 0 }
	},
	"supports": { "html": false, "align": [ "wide" ], "color": { "background": true, "text": true }, "spacing": { "padding": true, "margin": true }, "typography": { "fontSize": true } },
	"editorScript": "file:../../build/blocks/index.js",
	"style": "file:./style.css"
}
