{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "kits/sticky-cta",
	"title": "Sticky action",
	"category": "widgets",
	"description": "One action bar fixed to the bottom of the screen on phones.",
	"keywords": [ "sticky", "action", "button", "cta", "kits" ],
	"textdomain": "kits-core",
	"attributes": {
		"href": { "type": "string", "default": "" },
		"label": { "type": "string", "default": "" }
	},
	"supports": { "html": false, "color": { "background": true, "text": true } },
	"editorScript": "file:../../build/blocks/index.js",
	"style": "file:./style.css"
}
