{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/wp-admin/admin.php?page=insightweb",
  "preferredVersions": {
    "php": "8.2",
    "wp": "6.7"
  },
  "features": {
    "networking": true
  },
  "steps": [
    {
      "step": "login",
      "username": "admin",
      "password": "password"
    },
    {
      "step": "setSiteOptions",
      "options": {
        "blogname": "InsightWeb Playground",
        "blogdescription": "Telemetry dashboards, Search Console ingestion & keyword analytics"
      }
    },
    {
      "step": "installPlugin",
      "pluginZipFile": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/AnimalWrites/Kits/kits-suite/dist/insightweb.zip"
      }
    },
    {
      "step": "activatePlugin",
      "pluginPath": "insightweb/insightweb.php"
    }
  ]
}
