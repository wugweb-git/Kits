{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"title": "Dark",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "primary", "name": "Accent", "color": "#79B8FF" },
				{ "slug": "primary-dark", "name": "Accent ink", "color": "#2188FF" },
				{ "slug": "secondary", "name": "Ink", "color": "#F0F6FC" },
				{ "slug": "foreground", "name": "Text", "color": "#C9D1D9" },
				{ "slug": "text-muted", "name": "Muted", "color": "#8B949E" },
				{ "slug": "border", "name": "Line", "color": "#30363D" },
				{ "slug": "canvas", "name": "Page", "color": "#0D1117" },
				{ "slug": "surface", "name": "Surface", "color": "#161B22" },
				{ "slug": "background", "name": "Raised", "color": "#21262D" },
				{ "slug": "on-ink", "name": "On ink", "color": "#0D1117" },
				{ "slug": "focus", "name": "Focus", "color": "#58A6FF" },
				{ "slug": "error", "name": "Danger", "color": "#F85149" },
				{ "slug": "success", "name": "Success", "color": "#3FB950" },
				{ "slug": "warning", "name": "Warning", "color": "#D29922" },
				{ "slug": "error-soft", "name": "Danger tint", "color": "#3A1D1D" },
				{ "slug": "success-soft", "name": "Success tint", "color": "#1C3322" },
				{ "slug": "warning-soft", "name": "Warning tint", "color": "#382E1C" },
				{ "slug": "info-soft", "name": "Info tint", "color": "#1C2D42" },
				{ "slug": "whatsapp", "name": "WhatsApp", "color": "#2EA043" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--canvas)",
			"text": "var(--wp--preset--color--foreground)"
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--secondary)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--secondary)"
					}
				}
			}
		}
	}
}
